# Copy to .env.local and fill in. Never commit .env.local.

# From Supabase: Project Settings > API (or the output of `npx supabase start` for a local stack)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Storage bucket for product photos and the logo (created by supabase/setup.sql)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images

# Save orders to the database (and reduce stock) before opening WhatsApp. Set to false to skip.
NEXT_PUBLIC_SAVE_ORDERS=true

# Optional fallback. The WhatsApp number is normally set in Admin > Content > Shop settings.
NEXT_PUBLIC_WHATSAPP_NUMBER=
